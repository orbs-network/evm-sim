#!/bin/zsh
set -euo pipefail
cd "${0:A:h}"
build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT
forge build --out "$build_dir"
jq '{abi, runtime: .deployedBytecode.object}' "$build_dir/Simulator.sol/Simulator.json" > artifact/simulator.json
jq '{abi, runtime: .deployedBytecode.object}' "$build_dir/Simulator.t.sol/Token.json" > test/token.json
jq '{abi, runtime: .deployedBytecode.object}' "$build_dir/Simulator.t.sol/Router.json" > test/router.json
